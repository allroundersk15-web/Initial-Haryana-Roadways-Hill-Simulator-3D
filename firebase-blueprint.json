{
  "entities": {
    "DriverProfile": {
      "title": "DriverProfile",
      "description": "Cloud-saved Haryana Roadways driver profile tracking HTV license status, total distance, passengers carried, and career earnings.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID matching document ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Driver display name shown on HTV license badge."
        },
        "depotHome": {
          "type": "string",
          "enum": ["Panchkula", "Ambala", "Chandigarh", "Yamunanagar", "Kalka", "Rohtak"],
          "description": "Assigned Haryana Roadways home depot."
        },
        "totalEarningsInr": {
          "type": "number",
          "description": "Cumulative ticket fare earnings in Indian Rupees."
        },
        "totalKmDriven": {
          "type": "number",
          "description": "Cumulative kilometers driven across career and training."
        },
        "totalPassengersCarried": {
          "type": "number",
          "description": "Total passengers safely transported."
        },
        "htvLicenseEarned": {
          "type": "boolean",
          "description": "Whether all four HSSC heavy vehicle driving tracks are passed."
        },
        "preferredTransmission": {
          "type": "string",
          "enum": ["auto", "manual"],
          "description": "Preferred gearbox mode."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": [
        "uid",
        "displayName",
        "depotHome",
        "totalEarningsInr",
        "totalKmDriven",
        "totalPassengersCarried",
        "htvLicenseEarned",
        "preferredTransmission",
        "createdAt",
        "updatedAt"
      ]
    },
    "LicenseTestRecord": {
      "title": "LicenseTestRecord",
      "description": "Best official HSSC / Haryana Roadways IDTR test track attempt for a driver.",
      "type": "object",
      "properties": {
        "driverId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Parent driver UID."
        },
        "trackId": {
          "type": "string",
          "enum": ["figure8", "hBayReverse", "zigZag", "gradientRamp"],
          "description": "Official HSSC track identifier."
        },
        "passed": {
          "type": "boolean",
          "description": "Whether the driver passed this stage."
        },
        "bestScore": {
          "type": "number",
          "description": "Best score from 0 to 100."
        },
        "bestTimeSec": {
          "type": "number",
          "description": "Completion time in seconds."
        },
        "penalties": {
          "type": "number",
          "description": "Total cone touches or line faults."
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of attempt."
        }
      },
      "required": [
        "driverId",
        "trackId",
        "passed",
        "bestScore",
        "bestTimeSec",
        "penalties",
        "completedAt"
      ]
    },
    "TripLog": {
      "title": "TripLog",
      "description": "Immutable manifest of a completed Haryana-to-Himachal career bus trip.",
      "type": "object",
      "properties": {
        "driverId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Parent driver UID."
        },
        "routeId": {
          "type": "string",
          "enum": [
            "kalka-shimla",
            "ambala-manali",
            "ambala-dharamshala",
            "yamunanagar-reckong-peo"
          ],
          "description": "Career corridor identifier."
        },
        "routeTitle": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "description": "Display name of route."
        },
        "origin": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Starting Haryana depot."
        },
        "destination": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Himachal hill terminal."
        },
        "passengersBoarded": {
          "type": "number",
          "description": "Passengers carried during the run."
        },
        "fareCollectedInr": {
          "type": "number",
          "description": "Total rupees collected."
        },
        "safetyRating": {
          "type": "number",
          "description": "Driver safety rating out of 5."
        },
        "weather": {
          "type": "string",
          "enum": ["sunny", "mist", "rain", "night"],
          "description": "Weather condition selected for the trip."
        },
        "durationSec": {
          "type": "number",
          "description": "Trip duration in seconds."
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of completion."
        }
      },
      "required": [
        "driverId",
        "routeId",
        "routeTitle",
        "origin",
        "destination",
        "passengersBoarded",
        "fareCollectedInr",
        "safetyRating",
        "weather",
        "durationSec",
        "completedAt"
      ]
    }
  },
  "firestore": {
    "/drivers/{driverId}": {
      "schema": {
        "$ref": "#/entities/DriverProfile"
      },
      "description": "Owner-only Haryana Roadways driver profile."
    },
    "/drivers/{driverId}/licenseTests/{testId}": {
      "schema": {
        "$ref": "#/entities/LicenseTestRecord"
      },
      "description": "Official HSSC HTV driving test stage records scoped to a driver."
    },
    "/drivers/{driverId}/tripLogs/{tripId}": {
      "schema": {
        "$ref": "#/entities/TripLog"
      },
      "description": "Completed inter-state Himachal bus trip manifests scoped to a driver."
    }
  }
}
